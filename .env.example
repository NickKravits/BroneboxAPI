DATABASE_URL="mysql://USER:PASSWORD@IP_ADDRESS:3306/DB_NAME"
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=bronebox
DB_SSL=false
JWT_SECRET=your_jwt_secret
IP_ADDRESS=127.0.0.1
PORT=3000
DOMEN=http://127.0.0.1:5500
APP_URL=https://api.yourdomain.ru
FRONTEND_URL=https://yourdomain.ru
# Секретный ключ для POST /auth/register (создание нового кабинета/администратора).
# Сгенерируйте длинную случайную строку, например: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_REGISTRATION_KEY=REPLACE_WITH_LONG_RANDOM_STRING
# Список разрешённых origin через запятую, без пробелов. Пусто/не задано = разрешить все (dev-режим).
CORS_ALLOWED_ORIGINS=https://yourdomain.ru,https://api.yourdomain.ru
