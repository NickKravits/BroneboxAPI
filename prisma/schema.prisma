// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMINISTRATOR
  STAFF
}

enum Status {
  ACTIVE
  BLOCKED
  DELETED
}

enum TemPass {
  YES
  NO
}

model User {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  password     String
  tempass      TemPass  @default(YES)
  name         String?
  role         Role
  cabinet      Int
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  tokenVersion Int      @default(0)

  staff        Staff?
}

model Cabinet {
  id                  Int       @id @default(autoincrement())
  Timezone            Timezone  @default(EUROPE_MOSCOW)
  realtycalendarid    String?   @unique
  okidokiapi          String?
  okidokiwebhookkey   String?   @unique
  tochkaPhone         String?
  tochkaApiKey        String?   @db.VarChar(1000)
  tochkaMerchantId    String?
  tochkaPaymentMode   Json?
  tochkaVatType       Json?
  tochkaPurpose       String?
  tochkaName          String?
  tochkaPurposeDeposit String?
  tochkaNameDeposit    String?
  tochkaCustomerCode  String?
  tochkaOrgName       String?
  tochkaTaxCode       String?
  tochkaAppClientId   String?
  tochkaWebhookKey    String?   @unique
  cleaningTemplate    String?   @db.Text
  approxTimeMarker    String?   @default("~")
  emptyStayMarker     String?   @default("—")
  cleaningHeader      String?   @db.Text
  cleaningFooter      String?   @db.Text
  balance             Float     @default(0.0)
}

enum Timezone {
  ETC_GMT_1           @map("Etc/GMT-1")          // ХЗ, что, но (UTC+1)
  EUROPE_CENTRAL      @map("Europe/Berlin")      // Центральная Европа (UTC+1 / UTC+2) 
  EUROPE_KALININGRAD  @map("Europe/Kaliningrad") // Калининград (UTC+2)
  EUROPE_MOSCOW       @map("Europe/Moscow")      // Москва, Санкт-Петербург, Казань (UTC+3)
  EUROPE_SAMARA       @map("Europe/Samara")      // Самара, Ижевск (UTC+4)
  ASIA_YEKATERINBURG  @map("Asia/Yekaterinburg") // Екатеринбург, Пермь, Тюмень (UTC+5)
  ASIA_OMSK           @map("Asia/Omsk")          // Омск (UTC+6)
  ASIA_KRASNOYARSK    @map("Asia/Krasnoyarsk")   // Красноярск, Новосибирск, Томск (UTC+7)
  ASIA_IRKUTSK        @map("Asia/Irkutsk")       // Иркутск, Улан-Удэ (UTC+8)
  ASIA_YAKUTSK        @map("Asia/Yakutsk")       // Якутск, Чита, Благовещенск (UTC+9)
  ASIA_VLADIVOSTOK    @map("Asia/Vladivostok")   // Владивосток, Хабаровск (UTC+10)
  ASIA_MAGADAN        @map("Asia/Magadan")       // Магадан, Сахалин (UTC+11)
  ASIA_KAMCHATKA      @map("Asia/Kamchatka")     // Камчатка, Анадырь (UTC+12)
}

model Logs {
  id          Int         @id @default(autoincrement())
  cabinetid   Int
  status      LogStatus
  message     String
  date        DateTime    @default(now())
  readed      Thumbler    @default(NO)
}

enum LogStatus {
  INFO
  ERROR
  SUCCESS
}

enum Thumbler {
  YES
  NO
}

model Staff {
  id                Int      @id
  user              User     @relation(fields: [id], references: [id], onDelete: Cascade)
  cabinetid         Int
  manageobjects     Thumbler  @default(NO)
  managemaids       Thumbler  @default(NO)
  manageintegration Thumbler  @default(NO)
  managetemplates   Thumbler  @default(YES)
  manageautosent    Thumbler  @default(NO)
  seemaidsrate      Thumbler  @default(YES)
  managebooks       Thumbler  @default(NO)
}

model Maids {
  id                Int       @id @default(autoincrement())
  name              String
  rating            Float     @default(0.0)
  cabinetid         Int
}

model Objects {
  id              Int           @id @default(autoincrement())
  cabinetid       Int
  realtyid        Int?
  name            String
  instruction     String        @db.Text
  checkindef      String
  checkoutdef     String
  sspayanddeposit ShowSettings
  ssinstruction   ShowSettings
  sscontract      ShowSettings
  ssrateclean     ShowSettings
  location        String
  maplink         String?
  deposit         String
  odstringid      String?
  odvalueid       String?
  odnameid        String?
  oddateinid      String?
  oddateoutid     String?
  oddepositid     String?
  odpayperdayid   String?
  odpayedid       String?
  okidokiactive   Int           @default(0)
  depositchanel   DepositChanel @default(NONE)
  paymentchanel   PaymentChanel @default(NONE)
  active          Thumbler      @default(YES)

  photos          ObjectPhoto[]
}

enum DepositChanel {
  NONE
  MONETA
  TOCHKA
  TBANK
}

enum PaymentChanel {
  NONE
  TOCHKA
  TBANK
}

model ObjectPhoto {
  id        Int    @id @default(autoincrement())
  objectId  Int
  url       String
  sortOrder Int    @default(0)
  objects   Objects @relation(fields: [objectId], references: [id])
}

enum ShowSettings {
  IMMEDIATELY        // Сразу
  DAY_BEFORE         // За день до заселения
  AFTER_CHECKIN      // После заселения
  AFTER_CHECKOUT     // Сразу после выезда
}

model Bookings {
  status                BookStatus?
  id                    Int  @id
  begin_date            String?
  end_date              String?
  realty_id             Int?
  created_at            DateTime? @default(now())
  updated_at            DateTime? @default(now())
  amount                Int?
  notes                 String?
  source                String?
  prepayment            Int?
  balance_to_be_paid_1  Int?
  price_per_day         Int?
  deposit               Int?
  returned              Int?
  manual_deposit        Int?
  //client
  client_id             Int? //id
  fio                   String?
  email                 String?
  phone                 String?
  additional_phone      String?
  //CRM additional info
  cabinet               Int
  tochka_id_pay         Int?
  tochka_id_deposit     Int?
  begin_time            String?
  end_time              String?
  contract_status       String?
  contract_id           String?
  contract_link         String?
  maid_id               Int?
  review                Int?
  channel               String?    @default(" ")
  deposit_payment_link  String?

  link                  String
}

enum BookStatus {
  booked    //Бронь активна
  deleted   //Бронь удалена
  canceled  //Бронь отменена
  request   //Заявка
}

model CleaningSchedule {
  id            Int       @id @default(autoincrement())
  cabinetid     Int
  objectid      Int
  date          String
  booking_id    Int?
  maid_id       Int?
  checkin_time  String?
  checkout_time String?
  comment       String?   @db.Text
  included      Thumbler  @default(YES)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([cabinetid, objectid, date])
}

model UnprocessedBooking {
  id              Int       @id @default(autoincrement())
  cabinetid       Int
  bookingId       Int
  action          String
  failReason      String
  failMessage     String?   @db.Text
  realtyId        Int?
  beginDate       String?
  endDate         String?
  bookingStatus   String?
  source          String?
  amount          Int?
  notes           String?   @db.Text
  prepayment      Int?
  balanceToBePaid Int?
  pricePerDay     Int?
  deposit         Int?
  clientId        Int?
  fio             String?
  email           String?
  phone           String?
  additionalPhone String?
  resolved        Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

model BugReport {
  id          Int      @id @default(autoincrement())
  cabinetid   Int
  userId      Int
  message     String   @db.Text
  page        String?
  createdAt   DateTime @default(now())
}

model CabinetTemplate {
  id        Int      @id @default(autoincrement())
  cabinetid Int
  name      String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id             Int           @id @default(autoincrement())
  cabinetid      Int
  bookingId      Int
  amount         Float
  type           PaymentType
  method         PaymentMethod
  madeBy         String?
  receiptUrl     String?
  status         PaymentStatus
  returnedAmount Float?
  returnedAt     DateTime?
  externalId     String?
  link           String?
  linkExpiresAt  DateTime?
  createdAt      DateTime      @default(now())
  paidAt         DateTime?
  tochkaStatus      String?
  tochkaPaymentType String?
}

enum PaymentType {
  PAY
  DEPOSIT
}

enum PaymentMethod {
  MANAGER
  TOCHKA
  TBANK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  RETURNED
}